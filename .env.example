# Copy this file to .env and fill in your values

# Your Groq API key — get one free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Port to run the server on (default: 3000)
PORT=3000

# Absolute path to the project folder you want to browse
# Leave empty to use the folder where server.js lives
# Example: PROJECT_DIR=C:\Users\YourName\myproject
PROJECT_DIR=
